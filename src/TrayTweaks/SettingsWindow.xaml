<Window x:Class="TrayTweaks.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrayTweaks Settings"
        Icon="app.ico"
        Width="560"
        SizeToContent="Height"
        MaxHeight="760"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">
    <!-- The window draws its own title bar: the row holding the tab bar and the window buttons.
         CaptionHeight is that row's height, and is what can be dragged. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" GlassFrameThickness="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- The window background is untinted blurred glass (WindowBackdrop.cs), so it can be any
             brightness, and text is unreadable straight on it. Everything therefore sits on frosted
             islands: the tab bar, and one island per tab page (both drawn by the TabControl template
             below). Don't put text outside an island. -->
        <SolidColorBrush x:Key="FrostBrush" Color="{DynamicResource ApplicationBackgroundColor}" Opacity="0.6" />
        <!-- Panels on an island get the same colour at 70%, which makes them a step brighter than the island.
             The theme's own card brush is nearly transparent in dark mode. -->
        <SolidColorBrush x:Key="PlateBrush" Color="{DynamicResource ApplicationBackgroundColor}" Opacity="0.7" />
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="TabBar" HorizontalAlignment="Left" Padding="3" CornerRadius="9"
                                    Background="{StaticResource FrostBrush}"
                                    BorderBrush="#66FFFFFF" BorderThickness="1"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <StackPanel Orientation="Horizontal" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <Border Grid.Row="1" Margin="0,6,0,0" Padding="4" CornerRadius="9"
                                    Background="{StaticResource FrostBrush}"
                                    BorderBrush="#66FFFFFF" BorderThickness="1">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <!-- The tabs are inside the caption strip; without this a click on one drags the window.
                 Setting it on the bar is not enough: a tab inherits from the TabControl, not from the bar. -->
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Pill" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource FrostBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="close" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Pill" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,6" />
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PlateBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- Classic-style table: the frame draws the top and left lines, each cell its right and bottom. -->
        <Style x:Key="DenseFrame" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PlateBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
            <Setter Property="BorderThickness" Value="1,1,0,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="DenseCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </Window.Resources>

    <Grid>
    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0" Padding="3" CornerRadius="9"
            Background="{StaticResource FrostBrush}" BorderBrush="#66FFFFFF" BorderThickness="1"
            Height="36"
            WindowChrome.IsHitTestVisibleInChrome="True">
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource WindowButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" />
            <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;" ToolTip="Close" Tag="close" Click="Close_Click" />
        </StackPanel>
    </Border>
    <TabControl x:Name="Tabs" Margin="12,8,12,12">
        <TabItem Header="Tweaks">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,0,12,12">
                    <TextBlock Text="General" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Card}">
                        <CheckBox x:Name="StartWithWindows" Content="Start TrayTweaks when I sign in to Windows" />
                    </Border>

                    <TextBlock Text="Tweaks" Style="{StaticResource SectionHeader}" />
                    <ItemsControl x:Name="TweakList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="20"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,16,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="2"
                                                  IsChecked="{Binding IsEnabled}"
                                                  Visibility="{Binding ToggleVisibility}"
                                                  MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Margin="16,0,0,0" />
                                        <Button Grid.Column="2"
                                                Content="Run"
                                                Click="RunAction_Click"
                                                Visibility="{Binding ActionVisibility}"
                                                VerticalAlignment="Center"
                                                Margin="16,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Mouse">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,6,4,4" TextElement.FontSize="12">
                    <TextBlock Style="{StaticResource Note}" Margin="2,0,0,6">
                        <Run FontWeight="SemiBold" Text="Logitech G604" /><Run Text="  profile &quot;Hybrid MF&quot;, read 20 Nov 2026. Remapping the mouse does not update this page." />
                    </TextBlock>

                    <TextBlock Style="{StaticResource Note}" Margin="2,0,0,2"
                               Text="Thumb buttons, seen from the left side (front of the mouse on the left):" />
                    <Border Style="{StaticResource DenseFrame}">
                        <ItemsControl x:Name="ThumbGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DenseCell}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Sends}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding ShiftedLine}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Style="{StaticResource DenseFrame}" Margin="0,8,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource DenseCell}">
                                    <TextBlock Text="Other buttons" FontWeight="SemiBold" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource DenseCell}">
                                    <TextBlock Text="Sends" FontWeight="SemiBold" />
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource DenseCell}">
                                    <TextBlock Text="With G-Shift" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <ItemsControl x:Name="OtherButtons">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4*" />
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource DenseCell}">
                                                <TextBlock Text="{Binding Label}" />
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource DenseCell}">
                                                <TextBlock Text="{Binding Sends}" />
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource DenseCell}">
                                                <TextBlock Text="{Binding Shifted}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Note}" Margin="2,6,0,0"
                               Text="Other mice: two side buttons send Back and Forward. On the G604 both are on G6 (Forward on its own, Back with G-Shift)." />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Passwords">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,6,4,4" TextElement.FontSize="12">
                    <TextBlock Style="{StaticResource Note}" Margin="2,0,0,6"
                               Text="Text that TrayTweaks types for you. It is stored encrypted on this PC only, under your Windows account." />
                    <Border Style="{StaticResource DenseFrame}">
                        <ItemsControl x:Name="SecretList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DenseCell}" Padding="6,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock TextWrapping="Wrap">
                                                    <Run FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <!-- The dots box and the plain box share one spot; Show swaps them. -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                                                        Loaded="SecretEditor_Loaded">
                                                <Grid Width="120">
                                                    <PasswordBox PasswordChanged="SecretDots_Changed" />
                                                    <TextBox Visibility="Collapsed" TextChanged="SecretPlain_Changed" />
                                                </Grid>
                                                <ToggleButton Content="Show" Click="SecretShow_Click" MinWidth="52" Margin="4,0,0,0" />
                                                <Button Content="Save" Click="SaveSecret_Click" Margin="4,0,0,0" />
                                                <Button Content="Remove" Click="RemoveSecret_Click" Margin="4,0,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
    </Grid>
</Window>
