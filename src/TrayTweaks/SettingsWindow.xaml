<Window x:Class="TrayTweaks.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrayTweaks Settings"
        Icon="app.ico"
        Width="560"
        SizeToContent="Height"
        MaxHeight="760"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- The window background is untinted blurred glass (WindowBackdrop.cs), so it can be any
             brightness. Text that sits straight on the glass gets a halo in the theme's window colour
             to stay readable over a dark patch, the way Aero did it. -->
        <DropShadowEffect x:Key="GlassGlow" ShadowDepth="0" BlurRadius="8" Opacity="1"
                          Color="{DynamicResource ApplicationBackgroundColor}" />
        <!-- Panels get the same colour at 70%: the theme's own card brush is nearly transparent in dark mode. -->
        <SolidColorBrush x:Key="PlateBrush" Color="{DynamicResource ApplicationBackgroundColor}" Opacity="0.7" />
        <Style x:Key="OnGlass" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Effect" Value="{StaticResource GlassGlow}" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
            <Setter Property="Effect" Value="{StaticResource GlassGlow}" />
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PlateBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- Classic-style table: the frame draws the top and left lines, each cell its right and bottom. -->
        <Style x:Key="DenseFrame" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PlateBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
            <Setter Property="BorderThickness" Value="1,1,0,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="DenseCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </Window.Resources>

    <TabControl x:Name="Tabs" Margin="12,8,12,12">
        <TabItem>
            <TabItem.Header>
                <TextBlock Text="Tweaks" Effect="{StaticResource GlassGlow}" />
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,0,12,12">
                    <TextBlock Text="General" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Card}">
                        <CheckBox x:Name="StartWithWindows" Content="Start TrayTweaks when I sign in to Windows" />
                    </Border>

                    <TextBlock Text="Tweaks" Style="{StaticResource SectionHeader}" />
                    <ItemsControl x:Name="TweakList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="20"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,16,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="2"
                                                  IsChecked="{Binding IsEnabled}"
                                                  Visibility="{Binding ToggleVisibility}"
                                                  MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Margin="16,0,0,0" />
                                        <Button Grid.Column="2"
                                                Content="Run"
                                                Click="RunAction_Click"
                                                Visibility="{Binding ActionVisibility}"
                                                VerticalAlignment="Center"
                                                Margin="16,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <TextBlock Text="Mouse" Effect="{StaticResource GlassGlow}" />
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,6,4,4" TextElement.FontSize="12">
                    <TextBlock Style="{StaticResource OnGlass}" Margin="2,0,0,6">
                        <Run FontWeight="SemiBold" Text="Logitech G604" /><Run Text="  profile &quot;Hybrid MF&quot;, read 20 Nov 2026. Remapping the mouse does not update this page." />
                    </TextBlock>

                    <TextBlock Style="{StaticResource OnGlass}" Margin="2,0,0,2"
                               Text="Thumb buttons, seen from the left side (front of the mouse on the left):" />
                    <Border Style="{StaticResource DenseFrame}">
                        <ItemsControl x:Name="ThumbGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DenseCell}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Sends}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding ShiftedLine}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Style="{StaticResource DenseFrame}" Margin="0,8,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource DenseCell}">
                                    <TextBlock Text="Other buttons" FontWeight="SemiBold" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource DenseCell}">
                                    <TextBlock Text="Sends" FontWeight="SemiBold" />
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource DenseCell}">
                                    <TextBlock Text="With G-Shift" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <ItemsControl x:Name="OtherButtons">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4*" />
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource DenseCell}">
                                                <TextBlock Text="{Binding Label}" />
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource DenseCell}">
                                                <TextBlock Text="{Binding Sends}" />
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource DenseCell}">
                                                <TextBlock Text="{Binding Shifted}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource OnGlass}" Margin="2,6,0,0"
                               Text="Other mice: two side buttons send Back and Forward. On the G604 both are on G6 (Forward on its own, Back with G-Shift)." />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
